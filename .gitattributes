# Shell scripts and Docker files must stay LF even on Windows checkouts —
# CRLF breaks the `#!/bin/sh` interpreter line inside a Linux container.
*.sh            text eol=lf
docker/*        text eol=lf
Dockerfile      text eol=lf
entrypoint.sh   text eol=lf

# Source texts are hashed (sources/*/SOURCE.md, ADR-029): store and check out the
# exact bytes, or a CRLF conversion silently breaks every recorded sha256.
sources/**      -text
