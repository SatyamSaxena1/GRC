# Shell scripts and Docker files must stay LF even on Windows checkouts —
# CRLF breaks the `#!/bin/sh` interpreter line inside a Linux container.
*.sh            text eol=lf
docker/*        text eol=lf
Dockerfile      text eol=lf
entrypoint.sh   text eol=lf

# Source texts are hashed (sources/*/SOURCE.md, ADR-029): store and check out the
# exact bytes, or a CRLF conversion silently breaks every recorded sha256.
sources/**      -text

# The vendored NIST OSCAL schema is pinned by sha256 (tests/test_oscal_export.py): exact bytes on every OS.
tests/fixtures/oscal/**  -text

# Generated PDFs are binary: converting line endings on a Windows checkout would corrupt their stream offsets.
*.pdf           binary
