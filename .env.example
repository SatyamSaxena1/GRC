# Copy to .env and adjust. Nothing here is a secret in local development.

# --- database -----------------------------------------------------------------
# SQLite by default so the app runs with no infrastructure.
DATABASE_URL=sqlite:///./grc.db
# Postgres (docker compose up -d postgres) — required for row-level security:
# DATABASE_URL=postgresql+psycopg://grc:grc@localhost:5432/grc

# --- evidence storage ---------------------------------------------------------
STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=./evidence_storage
# MinIO / S3 (docker compose up -d minio):
# STORAGE_BACKEND=s3
# S3_BUCKET=grc-evidence
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1

# --- model gateway ------------------------------------------------------------
# Run `ollama list` and use a model you actually have pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_S=180
# Rasterization resolution for scanned-PDF pages sent to the VLM (app/documents.py).
VLM_RENDER_DPI=200

# --- real auth (optional) -------------------------------------------------------
# Unset means only the stub tokens work (org:<id> / user:<id> / auditor:<engagement_id>),
# exactly as before — nothing breaks without this. Set all three once Authentik
# (docker compose up -d authentik-server authentik-worker) has an OIDC application
# configured for this app. See docs/adr/011-oidc-auth.md.
# OIDC_ISSUER=http://localhost:9002/application/o/grc/
# OIDC_AUDIENCE=<the OAuth2 client id from Authentik>
# OIDC_JWKS_URL=http://localhost:9002/application/o/grc/jwks/

# --- CISO Assistant integration ------------------------------------------------
# Optional. Unset means locked verdicts and resolved gaps are recorded locally
# only (state row status SKIPPED) — nothing fails without this configured.
# CISO_ASSISTANT_BASE_URL=https://ciso-assistant.example.internal
# CISO_ASSISTANT_API_TOKEN=
CISO_ASSISTANT_TIMEOUT_S=10

# --- upload security ----------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MALWARE_SCANNER=noop
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# --- app ----------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=
