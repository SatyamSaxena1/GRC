# Pin an exact Ollama image tag (https://hub.docker.com/r/ollama/ollama/tags).
# Do not use `latest` — a silent upgrade can change model behaviour.
OLLAMA_VERSION=

# Server variant (docker-compose.yml): public hostname whose DNS A record points
# at this machine (Caddy gets the cert). Not used by the PC variant.
LLM_DOMAIN=llm.example.com

# PC variant (docker-compose.pc.yml): no token needed here — Tailscale Funnel
# authenticates interactively (`tailscale up --qr`, see README.md) and needs no
# card on file. Set OLLAMA_MAX_LOADED_MODELS=2 only on a 24 GB card.
# OLLAMA_MAX_LOADED_MODELS=1

# Shared secret: set the same value as OLLAMA_API_KEY in Render's `grc-secrets`.
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=

# Space-separated models to pull. qwen2.5vl:7b is the vision + text model the app
# uses today. Append a security-tuned text model once you have verified its exact
# Ollama/Hugging Face tag and licence (see README.md).
MODELS=qwen2.5vl:7b
